    local doorSound = Instance.new("Sound")

    doorSound.SoundId =
        "rbxassetid://1837829565"

    doorSound.Volume = 6
    doorSound.Name = "DoorBreaker"
    doorSound.Parent = workspace

    doorSound:Play()

