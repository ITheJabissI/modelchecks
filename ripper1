local function GetGitSound(url, filename, volume)
    local file = filename .. ".mp3"

    if not isfile(file) then
        local success, content = pcall(function()
            return game:HttpGet(url)
        end)

        if not success then
            warn("Couldn't download sound:", content)
            return nil
        end

        writefile(file, content)
    end

    local assetFunction = getcustomasset or getsynasset

    if not assetFunction then
        warn("getcustomasset/getsynasset is unavailable.")
        return nil
    end

    local sound = Instance.new("Sound")

    sound.Name = filename
    sound.SoundId = assetFunction(file)
    sound.Volume = volume or 1
    sound.Parent = workspace

    sound:Play()

    return sound
end

