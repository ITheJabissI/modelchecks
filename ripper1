        15,
        0,
        5.5,
        1,
        0
    )

    camShake:Shake(
        CameraShaker.Presets.Earthquake
    )

    pcall(function()
        currentRoom.Door.ClientOpen:FireServer()
    end)

    -- Actual spawned model
    local ripper = workspace:FindFirstChild("Ripper")

    if ripper then
        for _, v in ipairs(ripper:GetDescendants()) do
            if v:IsA("Sound") then
                v:Stop()
                v:Destroy()
            end
        end
    end

    -- Restore color
    TweenService:Create(
        colorEffect,
        TweenInfo.new(10),
        {
            TintColor = Color3.fromRGB(255, 255, 255),
            Saturation = 0,
            Contrast = 0
        }
    ):Play()

    Debris:AddItem(
        colorEffect,
