--==================================================
-- JUMPSCARE / DAMAGE CALLBACK
--==================================================

entity:SetCallback(
    "OnDamagePlayer",
    function(newHealth)

        print(
            "Ripper damage callback:",
            newHealth
        )

        task.spawn(function()

            local player =
                Players.LocalPlayer

            local character =
                player.Character
                or player.CharacterAdded:Wait()

            local humanoid =
                character:WaitForChild(
                    "Humanoid",
                    5
                )

            local humanoidRootPart =
                character:WaitForChild(
                    "HumanoidRootPart",
                    5
                )

            local camera =
                workspace.CurrentCamera

            if not humanoid
                or not humanoidRootPart then

                warn(
                    "Humanoid or HumanoidRootPart wasn't found."
                )

                return
            end

            --==================================================
            -- FIND RIPPER
            --==================================================

            -- IMPORTANT:
            -- Do NOT change the Entity.Name above.
            -- The actual spawned Workspace model is Ripper.
            local entityModel =
                workspace:FindFirstChild("Ripper")

            if not entityModel then

                warn(
                    "Ripper model wasn't found."
                )

                return
            end

            --==================================================
            -- PARTICLE TIMESCALE
            --==================================================

            local function SetAllParticlesTimeScale(
                model,
                timescale
            )

                for _, descendant in ipairs(
                    model:GetDescendants()
                ) do

                    if descendant:IsA(
                        "ParticleEmitter"
                    ) then

                        descendant.TimeScale =
                            timescale

                    end
                end
            end

            SetAllParticlesTimeScale(
                entityModel,
                0
            )

            --==================================================
            -- FIND RIPE
            --==================================================

            local primaryPart =
                entityModel:FindFirstChild(
                    "Ripe",
                    true
                )

            if not primaryPart
                or not primaryPart:IsA(
                    "BasePart"
                ) then

                warn(
                    "Ripe BasePart wasn't found inside Ripper."
                )

                return
            end

            --==================================================
            -- RIPE PARTICLES
            --==================================================

            local ripeAttachment =
                primaryPart:FindFirstChild(
                    "ripe",
                    true
                )

            if ripeAttachment then

                for _, child in ipairs(
                    ripeAttachment:GetDescendants()
                ) do

                    if child:IsA(
                        "ParticleEmitter"
                    ) then

                        child.Texture =
                            "rbxassetid://11816152645"

                        child.Squash =
                            NumberSequence.new(
                                0.4
                            )

                    end
                end
            end

            entityModel.PrimaryPart =
                primaryPart

            primaryPart.Anchored =
                true

            --==================================================
            -- CAMERA
            --==================================================

            camera.CameraType =
                Enum.CameraType.Scriptable

            local camConnection

            camConnection =
                RunService.RenderStepped:Connect(
                    function()

                        if primaryPart
                            and primaryPart.Parent then

                            camera.CFrame =
                                CFrame.lookAt(
                                    camera.CFrame.Position,
                                    primaryPart.Position
                                )

                        else

                            if camConnection then
                                camConnection:Disconnect()
                            end

                            camera.CameraType =
                                Enum.CameraType.Custom

                        end
                    end
                )

            --==================================================
            -- MOVE RIPPER
            --==================================================

            local tween =
                TweenService:Create(

                    primaryPart,

                    TweenInfo.new(
                        99999999999999,
                        Enum.EasingStyle.Linear
                    ),

                    {
                        CFrame =
                            humanoidRootPart.CFrame
                    }
                )

            tween:Play()

            --==================================================
            -- LOCK PLAYER
            --==================================================

            local anchorPart =
                Instance.new("Part")

            anchorPart.Name =
                "JumpscareAnchor"

            anchorPart.Size =
                Vector3.new(
                    1,
                    1,
                    1
                )

            anchorPart.Transparency =
                1

            anchorPart.Anchored =
                true

            anchorPart.CanCollide =
                false

            anchorPart.CanTouch =
                false

            anchorPart.CanQuery =
                false

            anchorPart.Position =
                humanoidRootPart.Position

            anchorPart.Parent =
                workspace

            local weld =
                Instance.new(
                    "WeldConstraint"
                )

            weld.Part0 =
                humanoidRootPart

            weld.Part1 =
                anchorPart

            weld.Parent =
                humanoidRootPart

            humanoid.WalkSpeed =
                0

            humanoid.JumpPower =
                0

            humanoid.AutoRotate =
                false

            humanoid.PlatformStand =
                true

            --==================================================
            -- KILL SOUND
            --==================================================

            GetGitSound(
                "https://github.com/eoyoustme/rebouna/blob/main/Kill_with_static.mp3?raw=true",
                "RipperKill",
                13
            )

            --==================================================
            -- FACE
            --==================================================

            task.wait(1.5)

            local faceDecal =
                entityModel:FindFirstChild(
                    "FaceDecal",
                    true
                )

            if faceDecal
                and faceDecal:IsA(
                    "Decal"
                ) then

                faceDecal.Texture =
                    "rbxassetid://1234567890"

            end

            --==================================================
            -- JUMPSCARE IMAGE
            --==================================================

            task.wait(0.5)

            local playerGui =
                player:WaitForChild(
                    "PlayerGui"
                )

            local screenGui =
                Instance.new(
                    "ScreenGui"
                )

            screenGui.Name =
                "JumpscareOverlay"

            screenGui.ZIndexBehavior =
                Enum.ZIndexBehavior.Sibling

            screenGui.ResetOnSpawn =
                false

            screenGui.IgnoreGuiInset =
                true

            screenGui.DisplayOrder =
                999999

            screenGui.Parent =
                playerGui

            local imageLabel =
                Instance.new(
                    "ImageLabel"
                )

            imageLabel.Name =
                "JumpscareImage"

            imageLabel.BackgroundTransparency =
                1

            imageLabel.BorderSizePixel =
                0

            imageLabel.Position =
                UDim2.new(
                    0,
                    0,
                    0,
                    0
                )

            imageLabel.Size =
                UDim2.new(
                    1,
                    0,
                    1,
                    0
                )

            imageLabel.ScaleType =
                Enum.ScaleType.Stretch

            imageLabel.Visible =
                true

            imageLabel.ZIndex =
                999999

            imageLabel.Parent =
                screenGui

            local jumpscareImage1 =
                "rbxassetid://94547864377343"

            local jumpscareImage2 =
                "rbxassetid://236542974"

            --==================================================
            -- FLASH
            --==================================================

            local flashDuration =
                1.2

            local flashStartTime =
                tick()

            while
                tick() - flashStartTime
                < flashDuration
            do

                imageLabel.Image =
                    jumpscareImage1

                task.wait(0.05)

                if
                    tick() - flashStartTime
                    >= flashDuration
                then

                    break

                end

                imageLabel.Image =
                    jumpscareImage2

                task.wait(0.05)

            end

            -- Hide image
            imageLabel.Visible =
                false

            --==================================================
            -- KILL
            --==================================================

            task.wait(0.5)

            if humanoid
                and humanoid.Parent then

                humanoid.PlatformStand =
                    false

                humanoid.AutoRotate =
                    true

                humanoid.Health =
                    0

                humanoid:ChangeState(
                    Enum.HumanoidStateType.Dead
                )

            end

            --==================================================
            -- CLEANUP
            --==================================================

            if camConnection then
                camConnection:Disconnect()
            end

            camera.CameraType =
                Enum.CameraType.Custom

            if tween then
                tween:Cancel()
            end

            if weld
                and weld.Parent then

                weld:Destroy()

            end

            if anchorPart
                and anchorPart.Parent then

                anchorPart:Destroy()

            end

            if screenGui
                and screenGui.Parent then

                screenGui:Destroy()

            end

            if entityModel
                and entityModel.Parent then

                entityModel:Destroy()

            end

        end)
    end
)

