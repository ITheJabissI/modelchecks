--==================================================
-- DAMAGE / JUMPSCARE
--==================================================

entity:SetCallback("OnDamagePlayer", function(newHealth)

    task.spawn(function()

        local player = Players.LocalPlayer

        local character =
            player.Character or player.CharacterAdded:Wait()

        local humanoid =
            character:WaitForChild("Humanoid", 5)

        local humanoidRootPart =
            character:WaitForChild("HumanoidRootPart", 5)

        if not humanoid or not humanoidRootPart then
            warn("Ripper: Humanoid not found")
            return
        end

        local camera = workspace.CurrentCamera

        --==================================================
        -- WAIT FOR THE ACTUAL RIPPER MODEL
        --==================================================

        local entityModel =
            workspace:WaitForChild("Ripper", 10)

        if not entityModel then
            warn("Ripper model was not found!")
            return
        end

        print("Ripper jumpscare started!")

        --==================================================
        -- FREEZE PARTICLES
        --==================================================

        for _, obj in ipairs(entityModel:GetDescendants()) do

            if obj:IsA("ParticleEmitter") then
                obj.TimeScale = 0
            end

        end

        --==================================================
        -- FIND RIPE
        --==================================================

        local primaryPart =
            entityModel:FindFirstChild("Ripe", true)

        if not primaryPart
            or not primaryPart:IsA("BasePart") then

            warn("Ripper: Ripe BasePart not found!")

            return
        end

        --==================================================
        -- RIPE PARTICLES
        --==================================================

        local ripeAttachment =
            primaryPart:FindFirstChild("ripe", true)

        if ripeAttachment then

            for _, obj in ipairs(
                ripeAttachment:GetDescendants()
            ) do

                if obj:IsA("ParticleEmitter") then

                    obj.Texture =
                        "rbxassetid://11816152645"

                    obj.Squash =
                        NumberSequence.new(0.4)

                end

            end

        end

        entityModel.PrimaryPart =
            primaryPart

        primaryPart.Anchored = true

        --==================================================
        -- CAMERA
        --==================================================

        camera.CameraType =
            Enum.CameraType.Scriptable

        local camConnection

        camConnection =
            RunService.RenderStepped:Connect(function()

                if primaryPart
                    and primaryPart.Parent then

                    camera.CFrame = CFrame.lookAt(
                        camera.CFrame.Position,
                        primaryPart.Position
                    )

                else

                    if camConnection then
                        camConnection:Disconnect()
                        camConnection = nil
                    end

                    camera.CameraType =
                        Enum.CameraType.Custom

                end

            end)

        --==================================================
        -- MOVE RIPPER TOWARD PLAYER
        --==================================================

        local tween =
            TweenService:Create(
                primaryPart,

                TweenInfo.new(
                    3,
                    Enum.EasingStyle.Linear
                ),

                {
                    CFrame =
                        humanoidRootPart.CFrame
                }
            )

        tween:Play()

        --==================================================
        -- FREEZE PLAYER
        --==================================================

        local oldWalkSpeed =
            humanoid.WalkSpeed

        local oldJumpPower =
            humanoid.JumpPower

        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true

        --==================================================
        -- KILL SOUND
        --==================================================

        GetGitSound(
            "https://github.com/eoyoustme/rebouna/blob/main/Kill_with_static.mp3?raw=true",
            "RipperKill",
            13
        )

        --==================================================
        -- WAIT BEFORE JUMPSCARE
        --==================================================

        task.wait(1.5)

        --==================================================
        -- JUMPSCARE IMAGE
        --==================================================

        local playerGui =
            player:WaitForChild("PlayerGui")

        -- Remove old jumpscare if one exists
        local oldGui =
            playerGui:FindFirstChild("JumpscareOverlay")

        if oldGui then
            oldGui:Destroy()
        end

        local screenGui =
            Instance.new("ScreenGui")

        screenGui.Name =
            "JumpscareOverlay"

        screenGui.ResetOnSpawn =
            false

        screenGui.IgnoreGuiInset =
            true

        screenGui.ZIndexBehavior =
            Enum.ZIndexBehavior.Sibling

        screenGui.DisplayOrder =
            999999

        screenGui.Parent =
            playerGui

        local imageLabel =
            Instance.new("ImageLabel")

        imageLabel.Name =
            "JumpscareImage"

        imageLabel.BackgroundTransparency =
            1

        imageLabel.BorderSizePixel =
            0

        imageLabel.Position =
            UDim2.new(0, 0, 0, 0)

        imageLabel.Size =
            UDim2.new(1, 0, 1, 0)

        imageLabel.ScaleType =
            Enum.ScaleType.Stretch

        imageLabel.ZIndex =
            999999

        imageLabel.Visible =
            true

        imageLabel.Parent =
            screenGui

        -- YOUR ORIGINAL IMAGES
        local jumpscareImage1 =
            "rbxassetid://94547864377343"

        local jumpscareImage2 =
            "rbxassetid://236542974"

        local flashDuration =
            1.2

        local startTime =
            tick()

        --==================================================
        -- FLASH IMAGES
        --==================================================

        while
            tick() - startTime < flashDuration
        do

            imageLabel.Image =
                jumpscareImage1

            task.wait(0.05)

            if
                tick() - startTime >= flashDuration
            then
                break
            end

            imageLabel.Image =
                jumpscareImage2

            task.wait(0.05)

        end

        --==================================================
        -- HIDE IMAGE
        --==================================================

        imageLabel.Visible =
            false

        task.wait(0.5)

        --==================================================
        -- KILL
        --==================================================

        if humanoid and humanoid.Parent then

            humanoid.PlatformStand =
                false

            humanoid.AutoRotate =
                true

            humanoid.WalkSpeed =
                oldWalkSpeed

            humanoid.JumpPower =
                oldJumpPower

            -- Actually kill the humanoid
            humanoid:TakeDamage(
                humanoid.MaxHealth + 100
            )

            -- Backup
            humanoid.Health = 0

            humanoid:ChangeState(
                Enum.HumanoidStateType.Dead
            )

        end

        --==================================================
        -- CLEANUP
        --==================================================

        if camConnection then
            camConnection:Disconnect()
            camConnection = nil
        end

        camera.CameraType =
            Enum.CameraType.Custom

        if tween then
            tween:Cancel()
        end

        if screenGui
            and screenGui.Parent then

            screenGui:Destroy()

        end

        if entityModel
            and entityModel.Parent then

            entityModel:Destroy()

        end

    end)

end)

